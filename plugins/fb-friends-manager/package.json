{
  "name": "opentabs-plugin-fb-friends-manager",
  "description": "Facebook friend requests and friends management with accept/delete suggestions",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Nadim Tuhin <nadimtuhin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadimtuhin/opentabs-plugins.git",
    "directory": "plugins/fb-friends-manager"
  },
  "type": "module",
  "main": "dist/adapter.iife.js",
  "keywords": [
    "opentabs-plugin"
  ],
  "opentabs": {
    "displayName": "Facebook Friends Manager",
    "description": "Facebook friend requests and friends management with accept/delete suggestions",
    "urlPatterns": [
      "*://*.facebook.com/*"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && opentabs-plugin build",
    "dev": "tsc --watch --preserveWatchOutput & opentabs-plugin build --watch",
    "type-check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --fix src/",
    "format:check": "biome format src/",
    "format": "biome format --write src/",
    "check": "npm run build && npm run type-check && npm run lint && npm run format:check"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@opentabs-dev/plugin-sdk": "^0.0.115"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@opentabs-dev/plugin-tools": "^0.0.115",
    "jiti": "^2.6.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
